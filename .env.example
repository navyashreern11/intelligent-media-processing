# Database configuration
DATABASE_URL=sqlite:///./media_processing.db

# File Upload configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Image Analysis thresholds
BLUR_THRESHOLD=100.0
LOW_LIGHT_THRESHOLD=60.0
MIN_IMAGE_WIDTH=200
MIN_IMAGE_HEIGHT=200

# Background Worker configuration
MAX_RETRIES=3

# Tesseract OCR path configuration (optional, specify path if not in system PATH)
# On Windows, this is typically: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
